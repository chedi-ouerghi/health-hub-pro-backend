# ─── App Configuration ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rdvdoctor?schema=public"

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=rdvdoctor_super_secure_jwt_secret_key_2026_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_256bit_random_secret_different_from_above_32chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (caching & rate limiting) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Cloudflare Turnstile (Anti-bot CAPTCHA) ──────────────────────────────────
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Rate Limiting Whitelist (optional) ───────────────────────────────────────
RATE_LIMIT_WHITELIST=127.0.0.1,::1

# ─── Sentry Error Tracking (optional) ─────────────────────────────────────────
SENTRY_DSN=

# ─── Two-factor authentication (optional, falls back to JWT_SECRET) ───────────
# Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=

# ─── Twilio SMS (optional) — codes are logged in dev when unset ───────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
