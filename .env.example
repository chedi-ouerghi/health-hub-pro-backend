# ─── App Configuration ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8080
# Informational allow-list; the backend also enforces its production/local list in src/main.ts.
CORS_ORIGINS=https://health-hub-pro.pages.dev,http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rdvdoctor?schema=public"

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=rdvdoctor_super_secure_jwt_secret_key_2026_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_256bit_random_secret_different_from_above_32chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin bootstrap (use only with the dedicated bootstrap command) ──────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin

# ─── Redis (caching & rate limiting) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Cloudflare Turnstile (Anti-bot CAPTCHA) ──────────────────────────────────
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Rate Limiting Whitelist (optional) ───────────────────────────────────────
RATE_LIMIT_WHITELIST=127.0.0.1,::1

# ─── Sentry Error Tracking (optional) ─────────────────────────────────────────
SENTRY_DSN=

# ─── Two-factor authentication (optional, falls back to JWT_SECRET) ───────────
# Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=

# ─── Resend email verification (optional in development) ─────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=


STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── Frontend build-time variables (set these in client/.env) ────────────────
# VITE_API_URL=https://your-render-service.onrender.com/api/v1
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
